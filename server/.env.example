DATABASE_URL=
NEON_AUTH_JWKS_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Amazon Nova model for meal generation (regional inference profile id).
# Override to us.amazon.nova-pro-v1:0 for deeper reasoning.
BEDROCK_MEAL_MODEL_ID=us.amazon.nova-lite-v1:0
# Apify -> Neon recipe seeding (out-of-band; leave blank to disable seeding)
APIFY_TOKEN=
APIFY_RECIPE_DATASET_ID=
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
BOX_PUBLIC_KEY_ID=
BOX_PRIVATE_KEY=
BOX_PASSPHRASE=
# Sharing: invite emails via Resend (optional — leave RESEND_API_KEY blank to
# disable sending; share links still work and are shown in the UI to copy).
RESEND_API_KEY=
SHARE_EMAIL_FROM=MyKitchenList <onboarding@resend.dev>
# Base URL used to build share links (the public client origin).
APP_BASE_URL=https://mykitchenlist.vercel.app
PORT=3001
